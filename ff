<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Портфолио AI-навыков — Николина Юлия</title>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg: #09090f;
        --card: rgba(255,255,255,0.055);
        --border: rgba(255,255,255,0.10);
        --text: #f5f5f7;
        --muted: #a7a7b5;
        --accent-1: #8b5cf6;
        --accent-2: #06b6d4;
        --accent-3: #ec4899;
    }

    body {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
                     Roboto, Arial, sans-serif;
        background:
            radial-gradient(circle at 10% 10%, rgba(139,92,246,.20), transparent 30%),
            radial-gradient(circle at 90% 20%, rgba(6,182,212,.16), transparent 28%),
            radial-gradient(circle at 50% 100%, rgba(236,72,153,.12), transparent 30%),
            var(--bg);
        color: var(--text);
        min-height: 100vh;
        line-height: 1.6;
    }

    .container {
        width: min(1100px, 92%);
        margin: 0 auto;
        padding: 70px 0;
    }

    /* HERO */

    .hero {
        position: relative;
        padding: 70px 0 90px;
        text-align: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        margin-bottom: 24px;
        border: 1px solid var(--border);
        border-radius: 50px;
        background: rgba(255,255,255,.045);
        color: #c7c7d3;
        font-size: 14px;
        letter-spacing: .04em;
        backdrop-filter: blur(12px);
    }

    .eyebrow::before {
        content: "";
        width: 7px;
        height: 7px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 12px #22c55e;
    }

    h1 {
        font-size: clamp(42px, 7vw, 82px);
        line-height: .98;
        font-weight: 800;
        letter-spacing: -0.055em;

        background: linear-gradient(
            110deg,
            #ffffff 5%,
            #b78cff 35%,
            #55d9ef 65%,
            #ff72c8 95%
        );

        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;

        text-shadow: 0 0 60px rgba(139,92,246,.15);
    }

    .hero-name {
        margin-top: 22px;
        font-size: 18px;
        color: var(--muted);
    }

    /* SECTION */

    section {
        margin-top: 70px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 42px;
        height: 42px;

        border-radius: 12px;

        background: linear-gradient(
            135deg,
            rgba(139,92,246,.25),
            rgba(6,182,212,.20)
        );

        border: 1px solid var(--border);
        color: #fff;
        font-weight: 700;
    }

    h2 {
        font-size: clamp(25px, 4vw, 36px);
        letter-spacing: -.035em;
    }

    /* SKILLS */

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .skill-card {
        position: relative;
        overflow: hidden;

        padding: 30px;

        border: 1px solid var(--border);
        border-radius: 24px;

        background: var(--card);
        backdrop-filter: blur(18px);

        transition:
            transform .35s ease,
            border-color .35s ease,
            box-shadow .35s ease;
    }

    .skill-card::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -90px;
        top: -90px;

        background: var(--accent);
        border-radius: 50%;
        filter: blur(60px);
        opacity: .15;

        transition: opacity .35s ease;
    }

    .skill-card:hover {
        transform: translateY(-8px);
        border-color: rgba(255,255,255,.23);
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }

    .skill-card:hover::before {
        opacity: .3;
    }

    .skill-icon {
        font-size: 32px;
        margin-bottom: 18px;
    }

    .skill-card h3 {
        font-size: 21px;
        margin-bottom: 12px;
    }

    .skill-card p {
        color: var(--muted);
        font-size: 16px;
    }

    /* TAGS */

    .tools {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
    }

    .tag {
        padding: 10px 16px;

        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;

        background: rgba(255,255,255,.045);
        color: #ddd;

        font-size: 14px;

        transition: all .25s ease;
    }

    .tag:hover {
        transform: translateY(-3px);
        background: rgba(255,255,255,.10);
        border-color: rgba(139,92,246,.55);
        box-shadow: 0 8px 25px rgba(139,92,246,.15);
    }

    /* CASE */

    .case {
        position: relative;
        padding: 35px;

        border-radius: 26px;

        background:
            linear-gradient(
                135deg,
                rgba(139,92,246,.15),
                rgba(6,182,212,.08)
            );

        border: 1px solid rgba(139,92,246,.25);

        overflow: hidden;
    }

    .case::after {
        content: "CASE";

        position: absolute;
        right: 25px;
        top: 20px;

        font-size: 70px;
        font-weight: 900;

        color: rgba(255,255,255,.025);

        pointer-events: none;
    }

    .case-label {
        display: inline-block;
        margin-bottom: 18px;

        padding: 6px 12px;

        border-radius: 8px;

        background: rgba(139,92,246,.20);
        color: #c4a9ff;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .case p {
        position: relative;
        z-index: 1;

        max-width: 800px;

        font-size: 20px;
        line-height: 1.55;
    }

    .highlight {
        color: #fff;
        font-weight: 650;
    }

    /* EFFECTIVENESS */

    .efficiency {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 25px;
        align-items: stretch;
    }

    .efficiency-main {
        padding: 35px;
        border-radius: 26px;

        background: rgba(255,255,255,.045);
        border: 1px solid var(--border);
    }

    .efficiency-main p {
        color: var(--muted);
        font-size: 18px;
        margin-top: 15px;
    }

    .mini-stats {
        display: grid;
        gap: 15px;
    }

    .stat {
        padding: 25px;

        border-radius: 20px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.045);

        transition: transform .3s ease;
    }

    .stat:hover {
        transform: scale(1.025);
    }

    .stat-number {
        font-size: 28px;
        font-weight: 800;

        background: linear-gradient(
            90deg,
            var(--accent-1),
            var(--accent-2)
        );

        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat-text {
        color: var(--muted);
        font-size: 14px;
    }

    /* FOOTER */

    footer {
        margin-top: 100px;
        padding-top: 30px;

        border-top: 1px solid var(--border);

        text-align: center;
        color: #777785;
        font-size: 14px;
    }

    /* MOBILE */

    @media (max-width: 700px) {

        .container {
            width: 90%;
            padding: 35px 0;
        }

        .hero {
            padding: 45px 0 50px;
        }

        .skills-grid,
        .efficiency {
            grid-template-columns: 1fr;
        }

        .skill-card,
        .case,
        .efficiency-main {
            padding: 25px;
        }

        .case p {
            font-size: 17px;
        }

        .case::after {
            font-size: 45px;
        }

        section {
            margin-top: 50px;
        }

        .section-heading {
            margin-bottom: 22px;
        }

        .tools {
            gap: 8px;
        }

        .tag {
            padding: 8px 13px;
        }
    }
</style>
</head>

<body>

